<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1500.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.StudentController">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <children>

        <VBox layoutX="110.4" layoutY="85.0" prefHeight="450.0" prefWidth="235.0" spacing="10.0" AnchorPane.bottomAnchor="287.0" AnchorPane.leftAnchor="110.0" AnchorPane.rightAnchor="1155.0" AnchorPane.topAnchor="85.0">
            <StackPane prefHeight="182.0" prefWidth="242.0" style="-fx-background-color: gray;">
                <ImageView fx:id="imageView" fitHeight="150.0" fitWidth="182.0" pickOnBounds="true" preserveRatio="true" />
            </StackPane>
            <Button fx:id="selectImageButton" mnemonicParsing="false" onMouseClicked="#openImageFileChooser" text="Select Image" />
            <Label text="ID:">
            <font>
               <Font size="15.0" />
            </font></Label>
            <TextField fx:id="idField" />
            <Label text="Name:">
            <font>
               <Font size="15.0" />
            </font></Label>
            <TextField fx:id="nameField" />
         <Label text="Gender">
            <font>
               <Font size="15.0" />
            </font>
         </Label>
         <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
            <children>
               <RadioButton fx:id="maleField" mnemonicParsing="false" text="Male">
                  <toggleGroup>
                     <ToggleGroup fx:id="genderGroup" />
                  </toggleGroup></RadioButton>
               <RadioButton fx:id="femaleField" lineSpacing="30.0" mnemonicParsing="false" text="Female" textAlignment="CENTER" toggleGroup="$genderGroup" />
            </children>
            <opaqueInsets>
               <Insets right="20.0" />
            </opaqueInsets>
         </HBox>
         <Label text="Faculty:">
            <font>
               <Font size="15.0" />
            </font>
         </Label>
         <ChoiceBox fx:id="choiceBoxField" prefHeight="26.0" prefWidth="243.0" />
        </VBox>
        <TableView fx:id="studentTable" layoutX="634.4" layoutY="124.8" onMouseClicked="#handleMouseAction" prefHeight="505.0" prefWidth="829.0" AnchorPane.bottomAnchor="192.0" AnchorPane.leftAnchor="634.0" AnchorPane.rightAnchor="37.0" AnchorPane.topAnchor="125.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="100.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="115.0" text="Name" />
                <TableColumn fx:id="emailColumn" prefWidth="115.0" text="Email" />
                <TableColumn fx:id="addressColumn" prefWidth="154.4000244140625" text="Address" />
                <TableColumn fx:id="phoneColumn" prefWidth="126.39996337890625" text="Phone Number" />
                <TableColumn fx:id="facultyColumn" minWidth="0.0" prefWidth="114.39996337890625" text="Faculty" />
            <TableColumn fx:id="genderColumn" minWidth="0.0" prefWidth="105.5999755859375" text="Gender" />
            <TableColumn fx:id="passwordColumn" minWidth="0.0" prefWidth="139.2000732421875" text="Password" />
            </columns>
        </TableView>
      <Label alignment="CENTER" layoutX="-1.0" layoutY="27.0" prefHeight="38.0" prefWidth="1321.0" text="Student Management ">
         <font>
            <Font size="26.0" />
         </font>
      </Label>
      <Label layoutX="1025.0" layoutY="100.0" prefWidth="57.0" text="Search:" />
      <TextField fx:id="searchField" layoutX="1090.0" layoutY="95.0" onKeyTyped="#handleSearchAction" />
      <VBox layoutX="378.0" layoutY="237.0" prefHeight="247.0" prefWidth="235.0" spacing="10.0">
         <children>
               <Label text="Email:">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
               <TextField fx:id="emailField" />
               <Label text="Address:">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
               <TextField fx:id="addressField" />
               <Label text="Phone Number:">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
               <TextField fx:id="phoneField" promptText="09-xxxxxxxxx" />
            <Label text="Password">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <TextField fx:id="passwordField" />
               <HBox spacing="10.0">
                   <Button onAction="#addStudent" text="Add" />
                   <Button onAction="#updateStudent" text="Update" />
                   <Button onAction="#deleteStudent" text="Delete" />
                   <Button mnemonicParsing="false" onAction="#clearForm" text="Clear" />
               </HBox>
         </children>
      </VBox>
    </children>
</AnchorPane>
