<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="856.0" prefWidth="1261.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.TeacherController">
    <children>
        <VBox layoutX="107.0" layoutY="65.0" prefHeight="277.0" prefWidth="242.0" spacing="10.0">
              <StackPane prefHeight="182.0" prefWidth="242.0" style="-fx-background-color: gray;">
               <children>
               <ImageView fx:id="imageView" fitHeight="184.0" fitWidth="242.0" pickOnBounds="true" preserveRatio="true" />
               </children>
              </StackPane>
            <Button fx:id="selectImageButton" mnemonicParsing="false" onMouseClicked="#openImageFileChooser" text="Select Image" />
         <Label text="ID" />
         <TextField fx:id="idField" />
            <Label text="Name:" />
            <TextField fx:id="nameField" />
            <Label text="Email:" />
            <TextField fx:id="emailField" prefHeight="26.0" prefWidth="274.0" />
            <Label text="Gender">
                <font>
                    <Font size="15.0" />
                </font>
            </Label>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                <children>
                    <RadioButton fx:id="maleField" mnemonicParsing="false" text="Male">
                        <toggleGroup>
                            <ToggleGroup fx:id="genderGroup" />
                        </toggleGroup></RadioButton>
                    <RadioButton fx:id="femaleField" lineSpacing="30.0" mnemonicParsing="false" text="Female" textAlignment="CENTER" toggleGroup="$genderGroup" />
                </children>
                <opaqueInsets>
                    <Insets right="20.0" />
                </opaqueInsets>
            </HBox>
         <Label text="Degree" />
         <ChoiceBox fx:id="degreeChoiceField" prefHeight="26.0" prefWidth="246.0" />
            <Label>
                <font>
                    <Font size="15.0" />
                </font>
            </Label>
        </VBox>

        <TableView fx:id="teacherTable" layoutX="629.0" layoutY="171.0" onMouseClicked="#handleMouseAction" prefHeight="356.0" prefWidth="842.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="70.4000244140625" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="110.39996337890625" text="Name" />
                <TableColumn fx:id="emailColumn" prefWidth="129.60003662109375" text="Email" />
            <TableColumn fx:id="addressColumn" prefWidth="127.9998779296875" text="Address" />
                <TableColumn fx:id="phoneColumn" prefWidth="109.5999755859375" text="Phone Number" />
            <TableColumn fx:id="departmentColumn" prefWidth="106.39990234375" text="Department" />
            <TableColumn fx:id="degreeColumn" prefWidth="98.4000244140625" text="Degree" />
            <TableColumn fx:id="genderColumn" prefWidth="86.400146484375" text="Gender" />
            </columns>
        </TableView>
        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="-1.0" layoutY="14.0" prefHeight="40.0" prefWidth="1563.0" text="Teacher Management">
         <font>
            <Font size="28.0" />
         </font>
      </Label>
        <Label layoutX="1265.0" layoutY="142.0" text="Search:" />
        <TextField fx:id="searchField" layoutX="1321.0" layoutY="138.0" onKeyTyped="#handleSearchAction" />
      <VBox layoutX="372.0" layoutY="391.0" prefHeight="260.0" prefWidth="230.0" spacing="10.0">
         <children>
            <Label text="Department" />
            <ChoiceBox fx:id="choiceBoxField" prefHeight="26.0" prefWidth="246.0" />
            <Label text="Address:" />
            <TextField fx:id="addressField" />
               <Label text="Phone Number:" />
               <TextField fx:id="phoneField" promptText="09-xxxxxxxxx" />
               <HBox spacing="10.0">
                   <Button onAction="#addTeacher" text="Add" />
                   <Button onAction="#updateTeacher" text="Update" />
                   <Button onAction="#deleteTeacher" text="Delete" />
                   <Button mnemonicParsing="false" onAction="#cleanForm" text="Clear" />
               </HBox>
         </children>
      </VBox>
    </children>
</AnchorPane>
