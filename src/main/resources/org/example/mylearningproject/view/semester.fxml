            <TableColumn fx:id="startDateColumn" prefWidth="136.79998779296875" text="start date" />
            <TableColumn fx:id="endDateColumn" prefWidth="151.2000732421875" text="end date" />
            <TableColumn fx:id="statusColumn" prefWidth="106.4000244140625" text="status" />
