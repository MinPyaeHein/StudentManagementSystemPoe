                           </children>
                        </HBox>
                     </children>
                  </Pane>
                  <Button fx:id="enrollmentbutton" layoutX="444.0" layoutY="393.0" mnemonicParsing="false" onAction="#enrollmentBtn" text="Enrollment" />
                  <Label layoutX="793.0" layoutY="31.0" text="Maxinum Credit  20">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Label>
               </children>
            </Pane>
         </children>
      </StackPane>
      <Label layoutY="14.0" prefHeight="30.0" prefWidth="1550.0" style="-fx-alignment: center;" text="Course Enrollment ">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label layoutX="675.0" layoutY="54.0" text="Semester Date: ">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="dateField" layoutX="800.0" layoutY="54.0" prefHeight="27.0" prefWidth="163.0">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button layoutX="81.0" layoutY="55.0" mnemonicParsing="false" onAction="#mainPagebtn" text="Back to Main Page" />
      <HBox layoutX="675.0" layoutY="123.0" prefHeight="22.0" prefWidth="242.0" spacing="20.0">
         <children>
            <Label text="Stduent Name:">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Label fx:id="nameLabel" prefHeight="20.0" prefWidth="118.0">
