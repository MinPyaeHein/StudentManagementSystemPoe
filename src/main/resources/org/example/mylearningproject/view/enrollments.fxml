<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1550.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.EnrollmentController">
   <children>
      <StackPane layoutX="370.0" layoutY="94.0" prefHeight="405.0" prefWidth="846.0">
         <children>
            <Pane prefHeight="402.0" prefWidth="846.0">
               <children>
                  <Pane layoutX="466.0" layoutY="89.0" prefHeight="265.0" prefWidth="366.0">
                     <children>
                        <HBox layoutX="1.0" layoutY="1.0" prefHeight="26.0" prefWidth="210.0" spacing="15.0">
                           <children>
                              <Label prefHeight="22.0" prefWidth="107.0" text="Current Credit ">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="creditsTextfield" disable="true" prefHeight="26.0" prefWidth="86.0" />
                           </children>
                        </HBox>
                        <TableView fx:id="selectedTable" layoutX="1.0" layoutY="26.0" onMouseClicked="#handleResultTableClick" prefHeight="200.0" prefWidth="365.0">
                          <columns>
                            <TableColumn fx:id="selectedCourseCodeColumn" prefWidth="175.199951171875" text="Course Code " />
                            <TableColumn fx:id="selectedCourseNameColumn" prefWidth="189.60003662109375" text="Course Name" />
                          </columns>
                        </TableView>
                        <Label layoutX="236.0" layoutY="4.0" text="Maxinum Credit  20">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                        <Button fx:id="enrollmentbutton" layoutX="7.0" layoutY="239.0" mnemonicParsing="false" onAction="#enrollmentBtn" text="Enrollment" />
                     </children>
                  </Pane>
                  <Pane layoutX="57.0" layoutY="24.0" prefHeight="354.0" prefWidth="366.0">
                     <children>
                        <TableView fx:id="courseTable" layoutX="1.0" layoutY="50.0" onMouseClicked="#handleCourseTableClick" prefHeight="302.0" prefWidth="365.0">
                          <columns>
                            <TableColumn fx:id="courseCodeColumn" prefWidth="87.0" text="Course Code" />
                            <TableColumn fx:id="courseNameColumn" prefWidth="168.0" text="Course Name" />
                              <TableColumn fx:id="creditsColumn" prefWidth="109.60003051757815" text="Credit" />
                          </columns>
                        </TableView>
                        <HBox layoutX="156.0" layoutY="14.0" prefHeight="30.0" prefWidth="210.0" spacing="20.0">
                           <children>
                              <Label text="Search:" />
                              <TextField fx:id="searchField" onKeyPressed="#handleSearchAction" />
                           </children>
                        </HBox>
                     </children>
                  </Pane>
               </children>
            </Pane>
         </children>
      </StackPane>
      <Label layoutY="45.0" prefHeight="30.0" prefWidth="1550.0" style="-fx-alignment: center;" text="Course Enrollment ">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
