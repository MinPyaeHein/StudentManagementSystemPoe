<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="1500.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.EnrollmentController">
   <children>
      <StackPane layoutX="316.0" layoutY="155.0" prefHeight="438.0" prefWidth="967.0">
         <children>
            <Pane prefHeight="406.0" prefWidth="989.0">
               <children>
                  <Pane layoutX="444.0" layoutY="41.0" prefHeight="336.0" prefWidth="509.0">
                     <children>
                        <TableView fx:id="selectedTable" layoutX="5.0" layoutY="23.0" onMouseClicked="#handleResultTableClick" prefHeight="312.0" prefWidth="499.0">
                          <columns>
                            <TableColumn fx:id="selectedCourseCodeColumn" prefWidth="175.199951171875" text="Course Code " />
                            <TableColumn fx:id="selectedCourseNameColumn" prefWidth="189.60003662109375" text="Course Name" />
                              <TableColumn fx:id="selectedStatusColumn" prefWidth="132.5999755859375" text="Status" />
                          </columns>
                        </TableView>
                        <HBox layoutY="-15.0" prefHeight="26.0" prefWidth="210.0" spacing="15.0">
