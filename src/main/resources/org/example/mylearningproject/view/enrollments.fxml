                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox layoutX="675.0" layoutY="94.0" prefHeight="20.0" prefWidth="242.0" spacing="40.0">
         <children>
            <Label text="Student ID: ">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Label fx:id="idLabel" prefHeight="25.0" prefWidth="62.0">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
</AnchorPane>
