                            <TableColumn fx:id="courseCodeColumn" prefWidth="87.0" text="Course Code" />
                            <TableColumn fx:id="courseNameColumn" prefWidth="168.0" text="Course Name" />
                              <TableColumn fx:id="creditsColumn" prefWidth="109.60003051757815" text="Credit" />
                          </columns>
                        </TableView>
                        <HBox layoutX="1.0" layoutY="20.0" prefHeight="30.0" prefWidth="210.0" spacing="20.0">
