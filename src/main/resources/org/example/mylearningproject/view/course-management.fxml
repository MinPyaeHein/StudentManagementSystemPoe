<AnchorPane prefHeight="856.0" prefWidth="1582.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.CouresController">
    <children>
        <VBox layoutX="48.0" layoutY="34.0" prefHeight="277.0" prefWidth="242.0" spacing="10.0">
            <Label text="ID" />
            <TextField fx:id="idField" />
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                <opaqueInsets>
                    <Insets right="20.0" />
                </opaqueInsets>
            </HBox>
            <Label text="Name:" />
            <TextField fx:id="courseNameField" />
            <Label text="Course code:" />
            <TextField fx:id="courseCodeField" />
            <Label text="Description">
                <font>
                    <Font size="15.0" />
                </font>
            </Label>
         <TextArea fx:id="descriptionField" minHeight="60.0" prefHeight="66.0" prefWidth="242.0" />
            <Label text="Credits:" />
         <TextField fx:id="creditField" />
            <Label text="Department:" />
            <ChoiceBox fx:id="departmentChoiceBox" prefHeight="26.0" prefWidth="246.0" />
            <Label text="Teacehr:" />
