            </HBox>
            <Label>
                <font>
                    <Font size="15.0" />
                </font>
            </Label>
        </VBox>
        <TableView fx:id="courseTable" layoutX="334.0" layoutY="114.0" onMouseClicked="#handleMouseAction" prefHeight="498.0" prefWidth="1214.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="70.4000244140625" text="ID" />
                <TableColumn fx:id="courseNameColumn" prefWidth="123.20001220703125" text="Course Name" />
                <TableColumn fx:id="courseCodeColumn" prefWidth="130.4000244140625" text="Course code" />
                <TableColumn fx:id="descriptionColumn" prefWidth="107.20001220703125" text="Description" />
                <TableColumn fx:id="creditsColumn" prefWidth="75.20001220703125" text="Credits" />
                <TableColumn fx:id="departmentColumn" prefWidth="120.79998779296875" text="Department" />
                <TableColumn fx:id="teacherColumn" prefWidth="98.4000244140625" text="Teacher" />
            <TableColumn fx:id="capacityColumn" prefWidth="80.0001220703125" text="Capacity" />
                <TableColumn fx:id="scheduleColumn" prefWidth="101.5999755859375" text="Schedule" />
            <TableColumn fx:id="createdTimeColumn" prefWidth="153.5999755859375" text="Created at" />
            <TableColumn fx:id="updatedTimeColumn" prefWidth="147.2000488281251" text="Updated at" />
            </columns>
        </TableView>
        <Label layoutX="565.0" layoutY="14.0" text="Courses Management">
            <font>
                <Font size="28.0" />
            </font>
        </Label>
        <Label layoutX="1243.0" layoutY="82.0" text="Search:" />
        <TextField fx:id="searchField" layoutX="1299.0" layoutY="78.0" onKeyTyped="#handleSearchAction" />
