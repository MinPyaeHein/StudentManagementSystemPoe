<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1500.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12"  xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.DepartmentController">
    <children>
        <VBox layoutX="378.0" layoutY="81.0" prefHeight="206.0" prefWidth="226.0" spacing="10.0">
            <Label text="ID:">
                <font>
                    <Font size="15.0" />
                </font></Label>
            <TextField fx:id="idField" prefHeight="26.0" prefWidth="168.0" />
            <Label text="Department Name:">
                <font>
                    <Font size="15.0" />
                </font></Label>
            <TextField fx:id="departmentField" />
            <HBox spacing="10.0">
                <Button onAction="#addDepartment" text="Add" />
                <Button onAction="#updateDepartment" text="Update" />
                <Button onAction="#deleteDepartment" text="Delete" />
                <Button mnemonicParsing="false" onAction="#clearForm" text="Clear" />
            </HBox>
        </VBox>
        <TableView fx:id="departmentTable" layoutX="655.0" layoutY="111.0" onMouseClicked="#handleMouseAction" prefHeight="346.0" prefWidth="379.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="112.0" text="ID" />
                <TableColumn fx:id="departmentColumn" prefWidth="266.40001220703124" text="Department " />
            </columns>
        </TableView>
        <Label layoutX="522.0" layoutY="39.0" text="Department Management ">
            <font>
                <Font size="26.0" />
            </font>
        </Label>
        <Label layoutX="816.0" layoutY="81.0" prefWidth="57.0" text="Search:" />
        <TextField fx:id="searchField" layoutX="886.0" layoutY="77.0" onKeyTyped="#handleSearchAction" />
    </children>
</AnchorPane>
